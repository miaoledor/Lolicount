# Environment (contains secrets: R2/S3 keys — AGENTS.md session rule)
.env

# Runtime data (SQLite db generated at runtime)
data/*.db
data/*.db-*

# Built frontend (SSG output, embedded via go:embed at build)
web/dist
web/node_modules
web/.nuxt
web/.output

# Go build output
/bin/
*.exe
*.test
*.out

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
test.md
node_modules

# Local build artifacts (not committed; use go build in CI/release).
/lolicount
/check-theme
/fix-theme

# Embedded frontend dist: only .gitkeep is tracked; real files are
# copied in at build time (release.yml / Dockerfile).
/assets/dist/*
!/assets/dist/.gitkeep
server
