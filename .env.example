# Lolicount configuration template.
# Copy to .env and edit. Never commit .env because it may contain secrets.

# ---- Server ----
# HTTP listen address.
HOST=127.0.0.1
# HTTP listen port.
PORT=9721
# Log level: trace/debug/info/warn/error/fatal/panic.
LOG_LEVEL=info

# Public origin (scheme://host[:port]) used to build the embed links shown
# on the web UI. Does NOT change where the server listens — only the URLs
# suggested for pasting into READMEs. Empty = use the request's own origin.
# Example: BASE_URL=https://lolicount.top
BASE_URL=

# ---- Storage (M1: only SQLite path exists, AGENTS.md Iron Rule 5) ----
# Path to the SQLite database file.
DB_PATH=data/count.db
# Seconds between buffer flushes to SQLite (production 5~10, demo up to 60).
DB_INTERVAL=10

# ---- Rate limiting ----
# IP-level: requests per second / per minute.
RATE_LIMIT_IP_PER_SEC=60
RATE_LIMIT_IP_PER_MIN=3000
# Name-level: increments per second, over-limit degrades to read-only (Iron Rule 3).
RATE_LIMIT_NAME_PER_SEC=20
# ---- Admin ----
# Admin key for protected maintenance endpoints. Leave empty to disable
# admin endpoints entirely (they return 404). Generate with:
#   openssl rand -hex 32
ADMIN_KEY=

# ---- Emote (PSB) models ----
# On-disk directory holding the E-mote models. NOT embedded in the binary:
# model files are streamed from this directory only when requested, and a
# missing/empty directory disables the widget endpoints (empty model list).
# Relative paths resolve against the working directory.
PSB_DIR=assets/psb
