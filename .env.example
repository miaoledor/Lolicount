# Lolicount configuration template.
# Copy to .env and edit. Never commit .env (contains R2/S3 secrets).

# ---- Server ----
# HTTP listen address.
HOST=0.0.0.0
# HTTP listen port.
PORT=9721
# Log level: trace/debug/info/warn/error/fatal/panic.
LOG_LEVEL=info

# Public origin (scheme://host[:port]) used to build the embed links shown
# on the web UI. Does NOT change where the server listens — only the URLs
# suggested for pasting into READMEs. Empty = use the request's own origin.
# Example: BASE_URL=https://lolicount.top
BASE_URL=

# ---- Storage (M1: only SQLite path exists, AGENTS.md Iron Rule 5) ----
# Path to the SQLite database file.
DB_PATH=data/count.db
# Seconds between buffer flushes to SQLite (production 5~10, demo up to 60).
DB_INTERVAL=10

# ---- Rate limiting (M4, reserved here for reference) ----
# IP-level: requests per second / per minute.
RATE_LIMIT_IP_PER_SEC=10
RATE_LIMIT_IP_PER_MIN=300
# Name-level: increments per second, over-limit degrades to read-only (Iron Rule 3).
RATE_LIMIT_NAME_PER_SEC=5
# Upload channel: per-IP quota per hour.
RATE_LIMIT_UPLOAD_PER_HOUR=5

# ---- Object storage for uploads (M6, reserved) ----
# STORAGE_TYPE=sqlite
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=
# R2_PUBLIC_BASE=
