{
  "name": "lolicount-dev",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "node scripts/preflight-port.js && go run ./cmd/server",
    "dev:web": "node scripts/dev-web.js",
    "build:web": "node scripts/build-web.js",
    "test:support": "node --experimental-strip-types --test scripts/support-heart-physics.test.mjs",
    "test:about": "node --experimental-strip-types --test scripts/about-statistics.test.mjs",
    "test:frontend": "node --experimental-strip-types --test scripts/support-heart-physics.test.mjs scripts/about-statistics.test.mjs scripts/reload-cooldown.test.mjs scripts/app-version.test.mjs scripts/readme-stats.test.mjs scripts/generate-form-i18n.test.mjs scripts/group-collapse.test.mjs scripts/lang-switch-ripple.test.mjs scripts/lang-switch-menu.test.mjs",
    "fix-theme": "go run ./cmd/fix-theme",
    "fix-theme:dry": "go run ./cmd/fix-theme --dry-run",
    "optimize:images": "node scripts/optimize-images.mjs",
    "optimize:images:check": "node scripts/optimize-images.mjs --check",
    "convert:webp": "node scripts/convert-webp.mjs",
    "convert:webp:check": "node scripts/convert-webp.mjs --check"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "oxipng-bin": "^1.0.0",
    "sharp": "^0.33.5"
  },
  "type": "module",
  "license": "AGPL-3.0"
}
